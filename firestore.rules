rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserAccount(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 40 &&
             data.emailVerified is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidVerificationCode(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             data.code is string && data.code.size() == 6 &&
             data.verified is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'email', 'name', 'username', 'emailVerified', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'name', 'username', 'emailVerified', 'createdAt', 'updatedAt']) &&
                       isValidUserAccount(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'name', 'username', 'emailVerified', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /codes/{codeId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(codeId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(codeId) &&
                         incoming().keys().hasAll(['userId', 'email', 'code', 'verified', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'email', 'code', 'verified', 'createdAt', 'updatedAt']) &&
                         isValidVerificationCode(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(codeId) &&
                         isValidVerificationCode(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().email == existing().email &&
                         incoming().code == existing().code &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['verified', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(codeId);
      }
    }
  }
}
